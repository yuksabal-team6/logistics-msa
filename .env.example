# docker-compose용 환경변수 예시. 복사해서 .env로 사용한다: cp .env.example .env
# .env는 .gitignore 대상이며 실제 값은 슬랙·노션으로 공유한다. 이 파일에는 실제 값을 넣지 않는다.

# PostgreSQL (비워 두면 docker-compose 기본값 postgres 사용)
DB_USERNAME=
DB_PASSWORD=

# JWT 서명 키 (api-gateway, user-service 공용). 표준 Base64 문자열, 디코딩 후 32바이트 이상
# 생성 예: openssl rand -base64 32
JWT_SECRET=

# order-service Slack 알림
SLACK_WEBHOOK_URL=
